          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Guide Tabs -->
      <div class="flex items-center gap-1.5 bg-muted/60 p-1 rounded-xl border border-border/60 flex-shrink-0 overflow-x-auto">
        <button
          id="guide-tab-btn-master"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-background text-foreground shadow-2xs transition-all cursor-pointer whitespace-nowrap"
        >
          <span>👑 Master Workspace</span>
        </button>
        <button
          id="guide-tab-btn-scheduler"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-muted-foreground hover:text-foreground transition-all cursor-pointer whitespace-nowrap"
        >
          <span>⚡ Dual-Scheduler Engine</span>
        </button>
        <button
          id="guide-tab-btn-matrix"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold text-muted-foreground hover:text-foreground transition-all cursor-pointer whitespace-nowrap"
        >
          <span>🚀 4-Shard Matrix Parallel</span>
        </button>
      </div>

      <!-- Guide Content (Scrollable) -->
      <div class="flex-1 overflow-y-auto space-y-4 pr-1 text-xs text-muted-foreground leading-relaxed">
        
        <!-- Tab 1: Master Workspace -->
        <div id="guide-tab-view-master" class="space-y-3.5">
          <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 space-y-2">
            <h4 class="font-bold text-foreground flex items-center gap-2 text-sm text-amber-600 dark:text-amber-400">
              <span>👑 ما هي المساحة الرئيسية (Master Workspace)؟</span>
            </h4>
            <p>
              المساحة الرئيسية هي <strong>مركز القيادة الشامل للمنصة</strong>. عند تعيين مساحة عمل كـ Master Workspace:
            </p>
            <ul class="list-disc list-inside space-y-1.5 pl-1">
              <li><strong>⚡ زر Run Now الشامل:</strong> يطلق المزامنة لكل الحسابات في <strong>جميع مساحات العمل دفعة واحدة</strong> بالتوازي عبر الـ 4 خوادم.</li>
              <li><strong>🕒 مهمة FastCron واحدة للمنصة:</strong> يمكنك إنشاء مهمة FastCron في الـ Master Workspace لتقوم بمزامنة وتحديث كافة المساحات في توقيت مخصص تختاره أنت.</li>
              <li><strong>🛑 مفتاح الإيقاف العام (Global Kill-Switch):</strong> تعطيل مجدول GitHub في الـ Master Workspace يوقف المجدول التلقائي للمنصة ككل فوراً.</li>
            </ul>
          </div>

          <div class="rounded-xl border border-border bg-background p-4 space-y-2">
            <h5 class="font-bold text-foreground">كيف تعيّن مساحة كـ Master Workspace؟</h5>
            <p>
              من قائمة اختيار المساحات بالأعلى، اضغط على <strong>Manage Workspaces (⚙️)</strong> ثم اضغط على زر <strong>Set Master 👑</strong> بجانب المساحة المطلوبة.
            </p>
          </div>
        </div>

        <!-- Tab 2: Dual-Scheduler -->
        <div id="guide-tab-view-scheduler" class="hidden space-y-3.5">
          <div class="rounded-xl border border-primary/20 bg-primary/5 p-4 space-y-2">
            <h4 class="font-bold text-foreground flex items-center gap-2 text-sm text-primary">
              <span>⚡ منظومة المجدول المزدوج (Dual-Scheduler Engine)</span>
            </h4>
            <p>
              تمتلك المنصة خيارين للجدولة التلقائية يمكنك التبديل بينهما بكل حرية واستقلالية:
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="rounded-xl border border-border bg-background p-3.5 space-y-1.5">
              <span class="font-bold text-foreground text-xs flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-primary"></span>
                <span>1. مجدول GitHub Actions (07:00 UTC)</span>
              </span>
              <p class="text-[11px]">
                يعمل تلقائياً يومياً في تمام الساعة 07:00 UTC (08:00 صباحاً بتوقيت المغرب). إذا كنت لا تريد تشغيله في هذا الوقت، يمكنك تعطيله بزر واحد من لوحة الإعدادات.
              </p>
            </div>

            <div class="rounded-xl border border-border bg-background p-3.5 space-y-1.5">
              <span class="font-bold text-foreground text-xs flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                <span>2. مجدول FastCron المخصص</span>
              </span>
              <p class="text-[11px]">
                يتيح لك تحديد التوقيت المفضل بدقة (مثلاً 03:00 UTC أو كل 6 ساعات) وإدارته بحرية كاملة عبر FastCron مع حماية التوكنات وتشفيرها.
              </p>
            </div>
          </div>

          <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-3 text-[11px] text-emerald-700 dark:text-emerald-300">
            💡 <strong>Zero-Resource Early Exit:</strong> عند تعطيل مجدول GitHub لمساحة ما، يتوقف الاسكربت فوراً في ثانية واحدة [SKIP] دون استهلاك أي دقائق مجانية أو الاتصال بـ Pinterest.
          </div>
        </div>

        <!-- Tab 3: Matrix Sharding -->
        <div id="guide-tab-view-matrix" class="hidden space-y-3.5">
          <div class="rounded-xl border border-border bg-background p-4 space-y-2">
            <h4 class="font-bold text-foreground text-sm flex items-center gap-2">
              <span>🚀 التوزيع المصفوفي المتوازي (Matrix Sharding — 4 Shards)</span>
            </h4>
            <p>
              عندما تملك عدداً كبيراً من الحسابات والبيينز، يقوم النظام تلقائياً بتوزيع الحمل:
            </p>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 text-center font-mono text-[11px]">
              <div class="p-2.5 rounded-lg border border-border bg-muted/30">
                <span class="font-bold text-foreground block">Shard 0</span>
                <span class="text-[10px] text-muted-foreground">خادم مستقل 1</span>
              </div>
              <div class="p-2.5 rounded-lg border border-border bg-muted/30">
                <span class="font-bold text-foreground block">Shard 1</span>
                <span class="text-[10px] text-muted-foreground">خادم مستقل 2</span>
              </div>
              <div class="p-2.5 rounded-lg border border-border bg-muted/30">
                <span class="font-bold text-foreground block">Shard 2</span>
                <span class="text-[10px] text-muted-foreground">خادم مستقل 3</span>
              </div>
              <div class="p-2.5 rounded-lg border border-border bg-muted/30">
                <span class="font-bold text-foreground block">Shard 3</span>
                <span class="text-[10px] text-muted-foreground">خادم مستقل 4</span>
              </div>
            </div>
            <p class="pt-2">
              ✨ <strong>النتيجة:</strong> معالجة آلاف البيينز في دقائق معدودة، بدون أي تعارض في أقفال قواعد البيانات (Zero Lock Contention)، مع ضبط تلقائي للسرعة ومعدل الطلبات لتفادي الحظر.
            </p>
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="flex items-center justify-end border-t border-border pt-3.5 flex-shrink-0">
        <button
          id="done-architecture-guide-modal-btn"
          type="button"
          class="rounded-xl bg-primary text-primary-foreground px-4 py-2 text-xs font-semibold hover:bg-primary/90 transition-all cursor-pointer shadow-xs"
        >
          Got It
        </button>
      </div>
    </div>
  </div>

  <!-- ═══ Tab 2 View: FastCron Pipeline & Automation ═══ -->
  <div id="pa-tab-view-automation" class="hidden space-y-6">
    <PinArchiveCronCard isMasterWorkspace={isMasterWorkspace} />
  </div>
  </div>
</Layout>

<script>
  import {
    humanAgeFromOldestPin,
    escapeHtml,
    toast,
    copyToClipboard,
    cleanPinterestUsername,
    timeAgo,
  } from '../lib/ui-helpers';
  import { paginateItems, type PaginationResult } from '../lib/pagination-helper';
  import {
    fmtNumberFull,
    fmtNumberCompact,
    fmtMetric,
    formatNextRun,
    formatTooltipNextRun,
    getAvatarStyle,
    renderLastResultBadges,
  } from '../lib/pinarchive/format';
  import { filterAccounts } from '../lib/pinarchive/filters';
  import {
    COLUMN_DEFS,
    loadColVisibility,
    saveColVisibility,
    resetColVisibility,
    loadDensityPreference,
    saveDensityPreference,
    loadNumFormatPreference,
    saveNumFormatPreference,
    loadSettingsExpandedPreference,
    saveSettingsExpandedPreference,
  } from '../lib/pinarchive/store';
  import {
    renderTableHeaderHtml,
    renderAccountsStripHtml,
    renderEmptyAccountsRowHtml,
  } from '../lib/pinarchive/table-render';
  import {
    getWorkspaceId,
    fetchJson,
    fetchOverview,
    fetchCompetitors,
    fetchSettings,
    saveSettings as saveSettingsApi,
    toggleAccountsIngest,
    updateAccountsInterval,
    deleteAccounts as deleteAccountsApi,
    dispatchAccountsGas,
    dispatchFastRefresh,
    reevaluateCandidates as reevaluateCandidatesApi,
  } from '../lib/pinarchive/api-client';
  import {
    executeBulkPause,
    executeBulkResume,
    executeBulkInterval,
    executeBulkDelete,
    executeBulkDiscovery,
    executeBulkAuditSweep,
    executeBulkSheetSync,
    executeBulkRefresh,
    executeBulkSendToCompetitors,
  } from '../lib/pinarchive/bulk-actions';

  let rawAccounts: any[] = [];
  const selectedAccounts = new Set<string>();

  // State
  let activeStatusTab: 'all' | 'active' | 'paused' = 'all';
  let accountSearchTerm = '';
  let selectedInterval = 'all';
  let isCompactNumbers = loadNumFormatPreference();
  let isCompactDensity = loadDensityPreference();
  let competitorMap = new Map<string, { id: string; username: string }>();

  // Pagination State (50 accounts/page)
  const ACCOUNTS_PAGE_SIZE = 50;
  let accountsCurrentPage = 1;
  let currentFilteredAccounts: any[] = [];
  let currentPagedAccounts: any[] = [];

  async function loadCompetitorUsernames() {
    try {
      const json = await fetchCompetitors();
      if (json.competitors && Array.isArray(json.competitors)) {
        competitorMap.clear();
        for (const c of json.competitors) {
          if (c.username) {
            competitorMap.set(String(c.username).toLowerCase().trim(), {
              id: c.id,
              username: c.username,
            });
          }
        }
        if (rawAccounts.length > 0) {
          filterAndRenderAccounts();
        }
      }
    } catch (e) {
      console.warn('Failed to load competitor usernames for PinArchive cross-badging:', e);
    }
  }

  // ─── Filter & Search Engine ───────────────────────────────────────────────
  function filterAndRenderAccounts(resetPage = false) {
    if (resetPage) {
      accountsCurrentPage = 1;
    }
    const filtered = filterAccounts(rawAccounts, {
      activeStatusTab,
      selectedInterval,
      accountSearchTerm,
    });

    currentFilteredAccounts = filtered;
    const paginated = paginateItems(filtered, accountsCurrentPage, ACCOUNTS_PAGE_SIZE);
    accountsCurrentPage = paginated.currentPage;
    currentPagedAccounts = paginated.pagedItems;

    renderAccountsStrip(paginated.pagedItems, paginated);
    updateAccountsPaginationUI(paginated);
  }

  function syncSelectAllCheckbox() {
    const selectAllCb = document.getElementById('select-all-accounts-cb') as HTMLInputElement | null;
    if (!selectAllCb) return;
    if (currentPagedAccounts.length === 0) {
      selectAllCb.checked = false;
      selectAllCb.indeterminate = false;
      return;
    }
    const pageSelectedCount = currentPagedAccounts.filter((a: any) => selectedAccounts.has(a.id)).length;
    selectAllCb.checked = pageSelectedCount === currentPagedAccounts.length;
    selectAllCb.indeterminate = pageSelectedCount > 0 && pageSelectedCount < currentPagedAccounts.length;
  }

  function updateAccountsPaginationUI(paginated: PaginationResult<any>) {
    const pageStartEl = document.getElementById('accounts-page-start');
    const pageEndEl = document.getElementById('accounts-page-end');
    const totalCountEl = document.getElementById('accounts-total-count');
    const currentPageEl = document.getElementById('accounts-current-page');
    const totalPagesEl = document.getElementById('accounts-total-pages');
    const prevBtn = document.getElementById('accounts-prev-page-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('accounts-next-page-btn') as HTMLButtonElement | null;

    if (pageStartEl) pageStartEl.textContent = String(paginated.pageStart);
    if (pageEndEl) pageEndEl.textContent = String(paginated.pageEnd);
    if (totalCountEl) totalCountEl.textContent = String(paginated.totalItems);
    if (currentPageEl) currentPageEl.textContent = String(paginated.currentPage);
    if (totalPagesEl) totalPagesEl.textContent = String(paginated.totalPages);

    if (prevBtn) prevBtn.disabled = !paginated.hasPrev;
    if (nextBtn) nextBtn.disabled = !paginated.hasNext;

    syncSelectAllCheckbox();
  }

  // ─── Column Visibility ───────────────────────────────────────────────────
  let colVisible: Record<string, boolean> = loadColVisibility();

  function buildColVisibilityMenu() {

    const colMenu = document.getElementById('pa-col-visibility-menu');
    if (!colMenu) return;
    colMenu.innerHTML = `
      <div class="flex items-center justify-between pb-2 px-1 border-b border-border/80 text-[11px] font-bold text-muted-foreground">
        <span>Toggle Columns</span>
        <button id="reset-pa-cols-btn" class="text-primary hover:underline text-[11px] font-bold cursor-pointer">Reset</button>
      </div>
      <div class="space-y-1 max-h-72 overflow-y-auto pt-1.5 pr-1">
        ${COLUMN_DEFS.map(
          (c) => `
          <label class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-muted/70 transition-colors text-xs font-semibold text-foreground select-none">
            <input type="checkbox" class="rounded-md accent-primary h-4 w-4 cursor-pointer" data-pa-col-key="${c.key}" ${colVisible[c.key] ? 'checked' : ''} />
            <span>${c.label}</span>
          </label>`
        ).join('')}
      </div>`;

    document.getElementById('reset-pa-cols-btn')?.addEventListener('click', () => {
      COLUMN_DEFS.forEach(c => { colVisible[c.key] = c.defaultVisible; });
      resetColVisibility();
      buildColVisibilityMenu();
      renderTableHeader();
      filterAndRenderAccounts();
    });

    colMenu.querySelectorAll<HTMLInputElement>('input[data-pa-col-key]').forEach((cb) => {
      cb.addEventListener('change', () => {
        const key = cb.dataset.paColKey!;
        colVisible[key] = cb.checked;
        saveColVisibility(colVisible);
        renderTableHeader();
        filterAndRenderAccounts();
      });
    });
  }

  function setupColVisibilityToggle() {
    const btn = document.getElementById('pa-col-visibility-btn');
    const colMenu = document.getElementById('pa-col-visibility-menu');
    const wrapper = document.getElementById('pa-col-visibility-wrapper');
    if (!btn || !colMenu) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      colMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (wrapper && !wrapper.contains(e.target as Node)) {
        colMenu.classList.add('hidden');
      }
    });
  }

  function renderTableHeader() {
    const thead = document.querySelector('#pinarchive-accounts-table thead');
    if (!thead) return;

    thead.innerHTML = renderTableHeaderHtml(colVisible);

    document.getElementById('select-all-accounts-cb')?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      // Standard Page-Scoped Selection: only select/deselect rows on the current page
      currentPagedAccounts.forEach((acc: any) => {
        if (checked) {
          selectedAccounts.add(acc.id);
        } else {
          selectedAccounts.delete(acc.id);
        }
      });
      const inputs = document.querySelectorAll<HTMLInputElement>('#accounts-table-body input[data-acc-select]');
      inputs.forEach(cb => {
        cb.checked = checked;
      });
      updateSelectedAccountsUI();
      syncSelectAllCheckbox();
    });
  }

  // ─── Table Body Renderer ──────────────────────────────────────────────────
  function renderAccountsStrip(accounts: any[], paginated?: PaginationResult<any>) {
    const tbody = document.getElementById('accounts-table-body');
    const stripCount = document.getElementById('accounts-strip-count');
    const total = paginated ? paginated.totalItems : (currentFilteredAccounts.length || accounts.length);
    if (stripCount) stripCount.textContent = `${total} ${total === 1 ? 'Account' : 'Accounts'}`;

    if (!tbody) return;

    if (accounts.length === 0) {
      tbody.innerHTML = renderEmptyAccountsRowHtml(rawAccounts.length > 0);
      return;
    }

    tbody.innerHTML = renderAccountsStripHtml(accounts, {
      colVisible,
      selectedAccounts,
      isCompactDensity,
      isCompactNumbers,
      competitorMap,
    });

    setupDelegatedTableListeners();
  }

  // ─── Density & Number Format Switches ────────────────────────────────────
  const densityToggleBtn = document.getElementById('pa-density-toggle-btn');
  const densityLabel = document.getElementById('pa-density-label');
  const numFormatToggleBtn = document.getElementById('pa-num-format-toggle-btn');
  const numFormatLabel = document.getElementById('pa-num-format-label');

  function updateDensityUI() {
    if (densityLabel) densityLabel.textContent = isCompactDensity ? 'Compact' : 'Comfortable';
  }
  densityToggleBtn?.addEventListener('click', () => {
    isCompactDensity = !isCompactDensity;
    saveDensityPreference(isCompactDensity ? 'compact' : 'comfortable');
    updateDensityUI();
    filterAndRenderAccounts();
  });
  updateDensityUI();

  function updateNumFormatUI() {
    if (numFormatLabel) numFormatLabel.textContent = isCompactNumbers ? 'Compact' : 'Full';
  }
  numFormatToggleBtn?.addEventListener('click', () => {
    isCompactNumbers = !isCompactNumbers;
    saveNumFormatPreference(isCompactNumbers ? 'compact' : 'full');
    updateNumFormatUI();
    filterAndRenderAccounts();
  });
  updateNumFormatUI();

  // ─── Status Tabs & Search Filters ─────────────────────────────────────────
  const statusTabBtns = document.querySelectorAll<HTMLButtonElement>('.pa-status-tab-btn');
  function syncStatusTabClasses() {
    statusTabBtns.forEach(b => {
      const tabKey = b.dataset.statusTab || 'all';
      const active = tabKey === activeStatusTab;
      b.className = active
        ? 'pa-status-tab-btn rounded-lg px-3 py-1.5 text-xs font-semibold bg-background text-foreground shadow-2xs transition-all whitespace-nowrap'
        : 'pa-status-tab-btn rounded-lg px-3 py-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground transition-all whitespace-nowrap';
    });
  }
  statusTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      activeStatusTab = (btn.dataset.statusTab as any) || 'all';
      syncStatusTabClasses();
      filterAndRenderAccounts(true);
    });
  });

  const searchInput = document.getElementById('account-search-input') as HTMLInputElement | null;
  const searchClearBtn = document.getElementById('pa-search-clear-btn');
  const intervalFilterSelect = document.getElementById('pa-interval-filter') as HTMLSelectElement | null;
  let searchDebounceTimer: ReturnType<typeof setTimeout> | null = null;

  searchInput?.addEventListener('input', () => {
    const val = searchInput.value.trim();
    if (val) searchClearBtn?.classList.remove('hidden');
    else searchClearBtn?.classList.add('hidden');

    if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
    searchDebounceTimer = setTimeout(() => {
      accountSearchTerm = val;
      filterAndRenderAccounts(true);
    }, 250);
  });

  searchClearBtn?.addEventListener('click', () => {
    if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
    if (searchInput) searchInput.value = '';
    accountSearchTerm = '';
    searchClearBtn?.classList.add('hidden');
    filterAndRenderAccounts(true);
  });

  intervalFilterSelect?.addEventListener('change', () => {
    selectedInterval = intervalFilterSelect.value;
    filterAndRenderAccounts(true);
  });

  // Setup accounts table pagination navigation
  document.getElementById('accounts-prev-page-btn')?.addEventListener('click', () => {
    if (accountsCurrentPage > 1) {
      accountsCurrentPage--;
      filterAndRenderAccounts(false);
    }
  });

  document.getElementById('accounts-next-page-btn')?.addEventListener('click', () => {
    const totalPages = Math.max(1, Math.ceil(currentFilteredAccounts.length / ACCOUNTS_PAGE_SIZE));
    if (accountsCurrentPage < totalPages) {
      accountsCurrentPage++;
      filterAndRenderAccounts(false);
    }
  });

  // ─── Overview & KPIs ──────────────────────────────────────────────────────
  async function loadOverview(retries = 2) {
    const kpiAccounts = document.getElementById('kpi-accounts-count');
    const kpiArchived = document.getElementById('kpi-archived-pins');
    const kpiSaves = document.getElementById('kpi-total-saves');
    const kpiShares = document.getElementById('kpi-total-shares');
    const metaText = document.getElementById('refresh-meta-text');
    const tbody = document.getElementById('accounts-table-body');

    try {
      const wsId = getWorkspaceId();
      const json = await fetchOverview(wsId);

      // FIRE-AND-FORGET: Fetch competitor badges independently without blocking KPIs
      setTimeout(() => loadCompetitorUsernames(), 100);

      const totals = json.totals || {};
      const accounts = json.accounts || [];
      rawAccounts = accounts;

      // Update KPI cards
      if (kpiAccounts) kpiAccounts.textContent = fmtNumberFull(totals.accounts ?? accounts.length);
      if (kpiArchived) kpiArchived.textContent = fmtNumberFull(totals.archived_pins ?? 0);
      if (kpiSaves) kpiSaves.textContent = fmtNumberFull(totals.sum_saves ?? 0);
      if (kpiShares) kpiShares.textContent = fmtNumberFull(totals.sum_shares ?? 0);

      // Meta refresh line
      if (metaText) {
        if (accounts.length > 0 && accounts[0].last_run_at) {
          metaText.textContent = `Last refreshed ${timeAgo(accounts[0].last_run_at)}`;
        } else {
          metaText.textContent = 'No sync runs recorded';
        }
      }

      renderTableHeader();
      filterAndRenderAccounts();
      updateCostEstimate();
    } catch (e: any) {
      if (retries > 0) {
        if (tbody) tbody.innerHTML = `<tr><td colspan="11" class="p-8 text-center text-xs text-muted-foreground animate-pulse">Retrying… (attempt ${3 - retries}/2)</td></tr>`;
        setTimeout(() => loadOverview(retries - 1), 1500);
        return;
      }
      console.error('Error loading PinArchive overview:', e);

      if (kpiAccounts) kpiAccounts.textContent = '—';
      if (kpiArchived) kpiArchived.textContent = '—';
      if (kpiSaves) kpiSaves.textContent = '—';
      if (kpiShares) kpiShares.textContent = '—';
      if (metaText) metaText.textContent = 'Sync schedule unavailable';

      if (tbody) tbody.innerHTML =
        `<tr><td colspan="11" class="p-8 text-center text-xs text-rose-500">
           Failed to load accounts. <button id="retry-load-btn" class="underline font-bold cursor-pointer ml-1">Retry</button>
         </td></tr>`;
      document.getElementById('retry-load-btn')?.addEventListener('click', () => {
        if (tbody) tbody.innerHTML = `<tr><td colspan="11" class="p-8 text-center text-xs text-muted-foreground animate-pulse">Loading tracked accounts…</td></tr>`;
        if (kpiAccounts) kpiAccounts.innerHTML = '<div class="h-8 w-12 bg-muted/60 rounded animate-pulse"></div>';
        if (kpiArchived) kpiArchived.innerHTML = '<div class="h-8 w-12 bg-muted/60 rounded animate-pulse"></div>';
        if (kpiSaves) kpiSaves.innerHTML = '<div class="h-8 w-12 bg-muted/60 rounded animate-pulse"></div>';
        if (kpiShares) kpiShares.innerHTML = '<div class="h-8 w-12 bg-muted/60 rounded animate-pulse"></div>';
        if (metaText) metaText.textContent = 'Loading sync schedule...';
        loadOverview(2);
      });
