  // ─── Delegated Action Handlers ────────────────────────────────────────────
  async function handleAccountStatusToggle(btn: HTMLElement) {
    const id = btn.getAttribute('data-acc-status-toggle');
    const currentStatus = btn.getAttribute('data-current-status');
    if (!id) return;
    const enabled = currentStatus === 'paused'; // if paused -> active; if active -> paused

    btn.style.opacity = '0.4';
    btn.style.pointerEvents = 'none';

    try {
      const wsId = getWorkspaceId();
      await toggleAccountsIngest(wsId, [id], enabled);
      const target = rawAccounts.find(a => a.id === id);
      if (target) {
        target.ingest_enabled = enabled;
        target.status = enabled ? 'active' : 'paused';
      }
      toast(`@${target?.username || 'Account'} is now ${enabled ? 'active' : 'paused'}`);
      filterAndRenderAccounts(false);
    } catch (e: any) {
      if (String(e.message || '').includes('403')) {
        toast('Admin access required to toggle account ingestion.', 'error');
      } else {
        toast(e.message || 'Error updating account status', 'error');
      }
    } finally {
      btn.style.opacity = '1';
      btn.style.pointerEvents = 'auto';
    }
  }

  async function handleIngestSwitchToggle(cb: HTMLInputElement) {
    const id = cb.getAttribute('data-acc-ingest-toggle');
    if (!id) return;
    const enabled = cb.checked;
    cb.disabled = true;

    try {
      const wsId = getWorkspaceId();
      await toggleAccountsIngest(wsId, [id], enabled);
      const target = rawAccounts.find(a => a.id === id);
      if (target) {
        target.ingest_enabled = enabled;
        target.status = enabled ? 'active' : 'paused';
      }
      toast(`@${target?.username || 'Account'} is now ${enabled ? 'active' : 'paused'}`);
      filterAndRenderAccounts(false);
    } catch (e: any) {
      cb.checked = !enabled;
      if (String(e.message || '').includes('403')) {
        toast('Admin access required to toggle account ingestion.', 'error');
      } else {
        toast(e.message || 'Error updating account status', 'error');
      }
    } finally {
      cb.disabled = false;
    }
  }

  async function handleIntervalChange(sel: HTMLSelectElement) {
    const username = sel.getAttribute('data-username');
    const accountId = sel.getAttribute('data-account-id');
    const prevDays = sel.getAttribute('data-prev-days');
    const newDays = parseInt(sel.value, 10);
    if (!newDays) return;

    sel.disabled = true;
    try {
      const wsId = getWorkspaceId();
      const json = await updateAccountsInterval(wsId, {
        account_id: accountId || undefined,
        username: username || undefined,
        interval_days: newDays,
      });
      sel.setAttribute('data-prev-days', String(newDays));
      const target = rawAccounts.find(a => (accountId && a.id === accountId) || (username && a.username === username));
      if (target) {
        target.interval_days = newDays;
        if (json.next_run_dates && (json.next_run_dates[target.id] || json.next_run_dates[target.username])) {
          target.next_run_at = json.next_run_dates[target.id] || json.next_run_dates[target.username];
        }
      }
      toast(`Discovery interval for @${username || 'account'} set to ${newDays}d`);
      filterAndRenderAccounts(false);
    } catch (e: any) {
      sel.value = prevDays || '3';
      toast(e.message || 'Error updating interval', 'error');
    } finally {
      sel.disabled = false;
    }
  }

  async function handleSendToCompetitor(btn: HTMLButtonElement) {
    const username = btn.getAttribute('data-send-to-comp-user');
    if (!username) return;

    const confirmed = confirm(`Track @${username} in Competitor Intelligence?`);
    if (!confirmed) return;

    const root = document.getElementById('pinarchive-page-root');
    const wsId = root?.getAttribute('data-workspace-id');

    btn.disabled = true;
    try {
      const res = await fetch('/api/admin/competitors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          workspace_id: wsId,
          username,
          account_type: 'competitor',
        }),
      });
      const json = await res.json();
      if (res.ok && json.success) {
        toast(`Sent @${username} to Competitor Intelligence & dispatched scraper!`);
        const compId = json.competitor?.id || json.competitors?.[0]?.id;
        fetch('/api/admin/competitor-ops', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'dispatch',
            workspace_id: wsId,
            competitor_id: compId || undefined,
            target_username: username,
            trigger: 'pinarchive_send',
            force: true,
          }),
        }).catch(console.warn);

        loadOverview(1);
      } else {
        toast(json.error || 'Failed to send account to Competitor Intelligence', 'error');
      }
    } catch (err: any) {
      toast(err.message || 'Network error', 'error');
    } finally {
      btn.disabled = false;
    }
  }

  // ─── Central Delegated Event Listener on Table Body ────────────────────────
  let delegatedListenersAttached = false;
  function setupDelegatedTableListeners() {
    if (delegatedListenersAttached) return;
    const tbody = document.getElementById('accounts-table-body');
    if (!tbody) return;

    tbody.addEventListener('change', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      if (target.matches('input[data-acc-select]')) {
        const cb = target as HTMLInputElement;
        const id = cb.getAttribute('data-acc-select');
        if (!id) return;
        if (cb.checked) selectedAccounts.add(id);
        else selectedAccounts.delete(id);
        updateSelectedAccountsUI();
        syncSelectAllCheckbox();
        return;
      }

      if (target.matches('.interval-select')) {
        handleIntervalChange(target as HTMLSelectElement);
        return;
      }

      if (target.matches('input[data-acc-ingest-toggle]')) {
        handleIngestSwitchToggle(target as HTMLInputElement);
        return;
      }
    });

    tbody.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      const toggleBtn = target.closest<HTMLElement>('[data-acc-status-toggle]');
      if (toggleBtn) {
        e.stopPropagation();
        handleAccountStatusToggle(toggleBtn);
        return;
      }

      const copyBtn = target.closest<HTMLElement>('[data-pa-copy-handle]');
      if (copyBtn) {
        e.stopPropagation();
        const handle = copyBtn.getAttribute('data-pa-copy-handle') || copyBtn.dataset.paCopyHandle;
        if (handle) copyToClipboard(handle, copyBtn);
        return;
      }

      const compBtn = target.closest<HTMLButtonElement>('[data-send-to-comp-user]');
      if (compBtn) {
        e.stopPropagation();
        handleSendToCompetitor(compBtn);
        return;
      }

      const delBtn = target.closest<HTMLButtonElement>('[data-single-delete-acc-id]');
      if (delBtn) {
        e.stopPropagation();
        const id = delBtn.getAttribute('data-single-delete-acc-id');
        if (id) openDeleteAccountsModal([id]);
        return;
      }
    });

    delegatedListenersAttached = true;
  }

  function updateSelectedAccountsUI() {
    const actionBar = document.getElementById('accounts-action-bar');
    const selectedLabel = document.getElementById('accounts-selected-label');
    const count = selectedAccounts.size;

    if (count > 0) {
      if (actionBar) {
        actionBar.classList.remove('hidden');
        actionBar.classList.add('flex');
      }
      if (selectedLabel) selectedLabel.textContent = `${count} selected`;
    } else {
      if (actionBar) {
        actionBar.classList.add('hidden');
        actionBar.classList.remove('flex');
      }
    }
  }

  // Safe backward-compatible wrappers for any historical callers
  function attachAccountSelectionListeners() { setupDelegatedTableListeners(); }
  function attachAccountIngestToggleListeners() { setupDelegatedTableListeners(); }
  function attachSingleDeleteListeners() { setupDelegatedTableListeners(); }
  function attachIntervalChangeListeners() { setupDelegatedTableListeners(); }
  function attachSendToCompetitorListeners() { setupDelegatedTableListeners(); }

