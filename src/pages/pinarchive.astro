---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import PinArchiveCronCard from '../components/pinarchive/PinArchiveCronCard.astro';
import AccountsTable from '../components/pinarchive/AccountsTable.astro';
import { getWorkspaces } from '../lib/workspaces';

const activeWorkspaceId = Astro.locals.activeWorkspaceId || '';
const workspaces = await getWorkspaces(Astro.locals.supabase);
const currentWorkspace = workspaces.find((w) => w.id === activeWorkspaceId) || workspaces[0];
const isMasterWorkspace = Boolean(currentWorkspace?.is_master);
---

<Layout title="PinArchive Intelligence" description="Historical pin performance, winning recipe clusters, SEO topics, and canonical variations.">
  <div id="pinarchive-page-root" data-workspace-id={activeWorkspaceId} data-is-master={isMasterWorkspace ? 'true' : 'false'}>
  
  <!-- ═══ Header & Primary Controls ═══ -->
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mb-6">
    <div>
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center justify-center rounded-2xl bg-primary/10 p-2.5 text-primary border border-primary/20 shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/>
          </svg>
        </span>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-xl font-bold tracking-tight text-foreground">PinArchive Intelligence</h1>
            <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-[11px] font-semibold text-primary border border-primary/20">
              Live Monitor
            </span>
          </div>
          <p class="text-xs text-muted-foreground mt-0.5">
            Historical creator pin archive, high-velocity winners, and real-time synchronization.
          </p>
        </div>
      </div>
    </div>

    <!-- Top Action Group (Uniform h-9 buttons with clean minimalist styling) -->
    <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-auto">
      <!-- Live Sync Status Pill -->
      <div id="refresh-meta-line" class="inline-flex h-9 items-center gap-2 rounded-xl border border-border/80 bg-card px-3 text-xs text-muted-foreground shadow-xs">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span id="refresh-meta-text" class="font-medium text-foreground">Loading sync schedule...</span>
      </div>

      <!-- Architecture Guide Trigger Button -->
      <button
        id="open-architecture-guide-btn"
        type="button"
        class="inline-flex h-9 items-center gap-1.5 rounded-xl border border-primary/30 bg-primary/10 text-primary hover:bg-primary hover:text-primary-foreground px-3 text-xs font-semibold shadow-xs transition-all cursor-pointer"
        title="View Architecture & Automation Guide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <span>📖 How It Works</span>
      </button>

      <!-- Track Creator / Add Account Button -->
      <button
        id="open-add-creator-modal"
        type="button"
        class="inline-flex h-9 items-center justify-center gap-1.5 rounded-xl bg-primary px-4 text-xs font-semibold text-primary-foreground shadow-sm hover:bg-primary/90 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <span>Track Creator</span>
      </button>

      <!-- Quick Navigation Toolbar -->
      <div class="flex items-center rounded-xl border border-border/80 bg-card p-0.5 shadow-xs">
        <button id="pa-refresh-btn" title="Refresh PinArchive overview data"
          class="inline-flex h-8 w-8 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground hover:bg-muted/80 transition-all">
          <svg id="pa-refresh-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
        </button>
        <div class="h-4 w-px bg-border/80 my-auto"></div>
        <a
          href="/pinarchive/winning-pins"
          class="inline-flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-xs font-semibold text-foreground hover:bg-muted/80 transition-all"
        >
          <span>🏆 Winning Pins →</span>
        </a>
        <div class="h-4 w-px bg-border/80 my-auto"></div>
        <a
          href="/pinarchive/topics"
          class="inline-flex h-8 items-center gap-1.5 rounded-lg px-2.5 text-xs font-semibold text-foreground hover:bg-muted/80 transition-all"
        >
          <span>🏷️ Topic Clusters →</span>
        </a>
      </div>
    </div>
  </div>

  {isMasterWorkspace && (
    <!-- ═══ 👑 Master Workspace (Global Orchestrator) Banner ═══ -->
    <div class="mb-6 rounded-2xl border border-amber-500/30 bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 shadow-xs">
      <div class="flex items-center gap-3.5">
        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-amber-500/20 text-amber-600 dark:text-amber-400 border border-amber-500/30 text-xl shadow-2xs">
          👑
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-foreground">Master Workspace (Global Multi-Tenant Orchestrator)</h3>
            <span class="rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-600 dark:text-amber-400 px-2.5 py-0.5 text-[10px] font-bold">ALL-WORKSPACES MODE</span>
          </div>
          <p class="text-xs text-muted-foreground mt-0.5">
            This workspace acts as the central command center. Automation dispatches and FastCron schedules configured here run across <strong>all active workspaces</strong> concurrently in parallel via 4 matrix sharding runners.
          </p>
        </div>
      </div>
    </div>
  )}

  <!-- ═══ PinArchive Tab Navigation (Segmented Minimalist Pill Switcher) ═══ -->
  <div class="mb-6 flex items-center gap-1 bg-muted/60 p-1 rounded-2xl border border-border/60 w-fit">
    <button
      id="pa-tab-btn-accounts"
      type="button"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-background text-foreground shadow-2xs transition-all cursor-pointer"
    >
      <span>👤 Tracked Accounts &amp; Ingest</span>
    </button>
    <button
      id="pa-tab-btn-automation"
      type="button"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-muted-foreground hover:text-foreground transition-all cursor-pointer"
    >
      <span>⚡ Pipeline &amp; Automation</span>
    </button>
  </div>

  <!-- ═══ Tab 1 View: Accounts, KPIs & Ingest Rules ═══ -->
  <div id="pa-tab-view-accounts" class="space-y-6">
  
    <!-- ═══ KPI Dashboard (4 cards with clean micro-borders) ═══ -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
      <!-- Card 1: Accounts -->
      <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-primary/30 transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
          <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Archived Accounts</span>
          <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20 group-hover:scale-105 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </span>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mt-2 font-mono tabular-nums" id="kpi-accounts-count">
            <div class="h-7 w-12 bg-muted/60 rounded animate-pulse"></div>
          </div>
          <div class="mt-2 text-[11px] text-muted-foreground flex items-center gap-1.5" id="kpi-accounts-sub">
            <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>
            <span>Tracked in workspace</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Archived Pins -->
      <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-emerald-500/30 transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
          <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Archived Pins</span>
          <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 group-hover:scale-105 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
          </span>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold tracking-tight text-emerald-600 dark:text-emerald-400 mt-2 font-mono tabular-nums" id="kpi-archived-pins">
            <div class="h-7 w-16 bg-muted/60 rounded animate-pulse"></div>
          </div>
          <div class="mt-2 text-[11px] text-muted-foreground flex items-center gap-1.5" id="kpi-archived-sub">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            <span>With verified metrics</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Total Saves -->
      <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-rose-500/30 transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
          <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Total Saves</span>
          <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 group-hover:scale-105 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          </span>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mt-2 font-mono tabular-nums" id="kpi-total-saves">
            <div class="h-7 w-20 bg-muted/60 rounded animate-pulse"></div>
          </div>
          <div class="mt-2 text-[11px] text-muted-foreground flex items-center gap-1.5" id="kpi-saves-sub">
            <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>
            <span>Cumulative saves</span>
          </div>
        </div>
      </div>

      <!-- Card 4: Total Shares -->
      <div class="rounded-2xl border border-border/80 bg-card p-4 sm:p-5 shadow-xs hover:border-blue-500/30 transition-all flex flex-col justify-between group">
        <div class="flex items-center justify-between">
          <span class="text-[10.5px] font-semibold text-muted-foreground uppercase tracking-wider">Total Shares</span>
          <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20 group-hover:scale-105 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          </span>
        </div>
        <div>
          <div class="text-2xl sm:text-3xl font-bold tracking-tight text-foreground mt-2 font-mono tabular-nums" id="kpi-total-shares">
            <div class="h-7 w-16 bg-muted/60 rounded animate-pulse"></div>
          </div>
          <div class="mt-2 text-[11px] text-muted-foreground flex items-center gap-1.5" id="kpi-shares-sub">
            <span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>
            <span>Engagement signals</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ PinArchive Ingestion & Archive Rules (Modern Bento Visual Rules) ═══ -->
    <section class="rounded-2xl border border-border/80 bg-card/70 backdrop-blur-sm shadow-xs overflow-hidden transition-all duration-200" aria-labelledby="ingest-settings-heading">
      
      <!-- Header Strip -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 p-4 sm:px-6 sm:py-3.5 bg-muted/20 border-b border-border/70">
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary border border-primary/20 shadow-2xs">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/><path d="m14.83 9.17 4.24-4.24"/><path d="m14.83 14.83 4.24 4.24"/><path d="m9.17 14.83-4.24 4.24"/><circle cx="12" cy="12" r="4"/>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h2 id="ingest-settings-heading" class="text-sm font-bold text-foreground">
                Pin Qualification &amp; Ingest Rules
              </h2>
              <span id="settings-summary-badge" class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                🟢 Ingest Active
              </span>
              <span id="settings-role-badge" class="hidden text-[10px] font-semibold px-2 py-0.5 rounded-full bg-muted text-muted-foreground">
                Admin Only
              </span>
            </div>
            <p class="text-[11px] text-muted-foreground mt-0.5">
              Multi-tier criteria to automatically qualify, rank, and archive winning creator pins.
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 self-start sm:self-auto flex-wrap">
          <span id="settings-status-msg" class="text-xs font-semibold"></span>
          <button
            id="reevaluate-candidates-btn"
            type="button"
            class="inline-flex h-9 items-center gap-1.5 rounded-xl border border-border/80 bg-background hover:bg-muted text-foreground px-3.5 text-xs font-semibold shadow-2xs hover:border-primary/40 transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
            title="Re-evaluate candidate pins against current rules"
          >
            <svg id="reevaluate-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><polyline points="21 3 21 9 15 9"/></svg>
            <span id="reevaluate-btn-text">Re-evaluate Candidates</span>
          </button>
          <button
            id="save-ingest-settings-btn"
            type="button"
            class="inline-flex h-9 items-center gap-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white px-4 text-xs font-bold shadow-xs hover:shadow-md transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer ring-1 ring-emerald-400/30"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            <span>Save Rules</span>
          </button>
          <button
            id="toggle-settings-collapse-btn"
            type="button"
            class="inline-flex h-9 items-center gap-1.5 text-xs font-semibold text-muted-foreground hover:text-foreground bg-muted/60 hover:bg-muted px-3 rounded-xl transition-colors cursor-pointer"
            title="Toggle settings visibility"
          >
            <span id="settings-collapse-text">Configure</span>
            <svg id="settings-collapse-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
        </div>
      </div>

      <!-- Modern Collapsible Form Body -->
      <div id="settings-panel-body" class="hidden p-5 sm:p-6 bg-card space-y-5">
        
        <!-- ═══ 2-Column Bento Grid: Qualification Criteria (Left) + Automation Routines (Right) ═══ -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
          
          <!-- LEFT CARD (col-span-7): Single Qualification Criteria Card with 3 Polished Tier Rows -->
          <div class="lg:col-span-7 rounded-2xl border border-border/80 bg-gradient-to-b from-card via-card to-background/50 p-4.5 sm:p-5 shadow-xs flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-border/60 mb-3.5">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-foreground">🎯 Qualification Criteria (OR Rules)</span>
                  <span class="text-[10px] text-muted-foreground font-medium">Automatic pin preservation thresholds</span>
                </div>
                <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full bg-primary/10 text-primary border border-primary/25">
                  OR Logic
                </span>
              </div>

              <!-- 3 Stacked Tier Rows -->
              <div class="space-y-3">
                
                <!-- Row 1: Star Performers (Min Saves) -->
                <div class="flex items-center justify-between gap-3 p-3 rounded-xl border border-emerald-500/25 bg-emerald-500/5 hover:border-emerald-500/45 transition-all group">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 text-sm font-bold border border-emerald-500/25 shadow-2xs group-hover:scale-105 transition-transform">
                      🌟
                    </div>
                    <div class="min-w-0">
                      <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-foreground truncate">Star Performers (Saves)</span>
                        <span class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.2 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">Tier 1</span>
                      </div>
                      <div class="text-[10px] text-muted-foreground truncate mt-0.5">High cumulative saves across all creator boards</div>
                    </div>
                  </div>
                  <div class="flex items-center gap-1.5 shrink-0">
                    <label for="setting-min-saves" class="text-xs font-semibold text-muted-foreground whitespace-nowrap">Min:</label>
                    <div class="flex items-center rounded-xl border border-border bg-background px-2 py-1 shadow-2xs focus-within:border-emerald-500 focus-within:ring-2 focus-within:ring-emerald-500/20">
                      <input id="setting-min-saves" type="number" min="0" value="25" class="w-14 bg-transparent text-xs font-bold text-foreground text-center font-mono focus:outline-none" />
                      <span class="text-[10px] font-semibold text-muted-foreground pl-1">saves</span>
                    </div>
                  </div>
                </div>

                <!-- Row 2: High Virality (Min Repins) -->
                <div class="flex items-center justify-between gap-3 p-3 rounded-xl border border-blue-500/25 bg-blue-500/5 hover:border-blue-500/45 transition-all group">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-blue-500/15 text-blue-600 dark:text-blue-400 text-sm font-bold border border-blue-500/25 shadow-2xs group-hover:scale-105 transition-transform">
                      🔁
                    </div>
                    <div class="min-w-0">
                      <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-foreground truncate">High Virality (Repins)</span>
                        <span class="text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.2 rounded bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">Tier 2</span>
                      </div>
                      <div class="text-[10px] text-muted-foreground truncate mt-0.5">Viral repin distribution across Pinterest networks</div>
                    </div>
                  </div>
                  <div class="flex items-center gap-1.5 shrink-0">
                    <label for="setting-min-repins" class="text-xs font-semibold text-muted-foreground whitespace-nowrap">Min:</label>
                    <div class="flex items-center rounded-xl border border-border bg-background px-2 py-1 shadow-2xs focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/20">
                      <input id="setting-min-repins" type="number" min="0" value="25" class="w-14 bg-transparent text-xs font-bold text-foreground text-center font-mono focus:outline-none" />
                      <span class="text-[10px] font-semibold text-muted-foreground pl-1">repins</span>
                    </div>
                  </div>
                </div>

                <!-- Row 3: Fast Risers (Velocity Rule) -->
                <div class="flex items-center justify-between gap-3 p-3 rounded-xl border border-amber-500/25 bg-amber-500/5 hover:border-amber-500/45 transition-all group">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400 text-sm font-bold border border-amber-500/25 shadow-2xs group-hover:scale-105 transition-transform">
                      🚀
                    </div>
