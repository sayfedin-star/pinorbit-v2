  function renderScheduling(acc: Account) {
    const startedElem = document.getElementById('sched-started-at');
    const windowElem = document.getElementById('sched-posting-window');
    const intervalElem = document.getElementById('sched-posting-interval');
    const delayElem = document.getElementById('sched-random-delay');
    const tzElem = document.getElementById('sched-timezone');
    const lastPubElem = document.getElementById('sched-last-published');
    const statusElem = document.getElementById('sched-live-status');
    const countdownElem = document.getElementById('sched-next-countdown');
    const activeDaysElem = document.getElementById('sched-active-days');
    const paceValElem = document.getElementById('sched-pace-val');
    const paceDescElem = document.getElementById('sched-pace-desc');

    const tz = acc.timezone || 'Europe/London';
    const now = new Date();

    let targetTimeStr = '';
    let offsetStr = '';
    let currentDayStr = 'Mon';
    try {
      const formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: tz,
        hour: '2-digit',
        minute: '2-digit',
        hour12: true,
        weekday: 'short',
      });
      const parts = formatter.formatToParts(now);
      const hourPart = parts.find((p) => p.type === 'hour')?.value || '12';
      const minPart = parts.find((p) => p.type === 'minute')?.value || '00';
      const dayPeriod = parts.find((p) => p.type === 'dayPeriod')?.value || 'AM';
      currentDayStr = parts.find((p) => p.type === 'weekday')?.value || 'Mon';
      targetTimeStr = `${hourPart}:${minPart} ${dayPeriod}`;

      const tzFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: tz,
        timeZoneName: 'short',
      });
      const tzParts = tzFormatter.formatToParts(now);
      const tzName = tzParts.find((p) => p.type === 'timeZoneName')?.value || '';
      offsetStr = tzName ? ` (${tzName})` : '';
    } catch (e) {
      targetTimeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    if (tzElem) {
      tzElem.textContent = `${tz}${offsetStr} • ${targetTimeStr}`;
    }

    // 2. Window start & end minutes (strip seconds for clean display)
    const rawStart = acc.posting_window_start || '09:00';
    const rawEnd = acc.posting_window_end || '21:00';
    const startStr = rawStart.slice(0, 5);
    const endStr = rawEnd.slice(0, 5);

    const [startH, startM] = startStr.split(':').map(Number);
    const [endH, endM] = endStr.split(':').map(Number);

    const startTotalMins = (startH || 0) * 60 + (startM || 0);
    const endTotalMins = (endH || 0) * 60 + (endM || 0);

    let windowDurationMins = endTotalMins - startTotalMins;
    if (windowDurationMins <= 0) windowDurationMins += 1440;
    const windowHours = (windowDurationMins / 60).toFixed(1).replace(/\.0$/, '');

    if (windowElem) {
      windowElem.textContent = `${startStr} — ${endStr} (${windowHours} hrs)`;
    }

    const allWeekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    let activeDays: string[] = allWeekdays;
    if (Array.isArray(acc.active_days)) {
      activeDays = acc.active_days;
    } else if (typeof acc.active_days === 'string') {
      activeDays = (acc.active_days as string).replace(/[{}"']/g, '').split(',').map((d) => d.trim());
    }

    const isDayActive = activeDays.includes(currentDayStr);

    if (activeDaysElem) {
      activeDaysElem.innerHTML = allWeekdays
        .map((day) => {
          const isActive = activeDays.includes(day);
          return `<span class="inline-flex items-center rounded-lg px-2.5 py-1 text-xs font-bold ${
            isActive
              ? 'bg-primary/10 border border-primary/20 text-primary'
              : 'bg-muted/50 border border-border text-muted-foreground line-through opacity-50'
          }">${day}</span>`;
        })
        .join('');
    }

    let nowMinutes = 0;
    try {
      const nowFormatter = new Intl.DateTimeFormat('en-US', {
        timeZone: tz,
        hour: 'numeric',
        minute: 'numeric',
        hour12: false,
      });
      const nowParts = nowFormatter.formatToParts(now);
      const nowH = parseInt(nowParts.find((p) => p.type === 'hour')?.value || '0', 10);
      const nowM = parseInt(nowParts.find((p) => p.type === 'minute')?.value || '0', 10);
      nowMinutes = nowH * 60 + nowM;
    } catch (e) {
      nowMinutes = now.getHours() * 60 + now.getMinutes();
    }

    let isInWindow = false;
    if (startTotalMins <= endTotalMins) {
      isInWindow = nowMinutes >= startTotalMins && nowMinutes <= endTotalMins;
    } else {
      isInWindow = nowMinutes >= startTotalMins || nowMinutes <= endTotalMins;
    }

    if (!acc.is_active) {
      if (statusElem) {
        statusElem.className = 'inline-flex items-center gap-1.5 rounded-full bg-rose-500/10 border border-rose-500/30 px-2.5 py-0.5 text-[11px] font-bold text-rose-500';
        statusElem.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span><span>Account Deactivated</span>`;
      }
      if (countdownElem) {
        countdownElem.textContent = 'Publishing Paused';
      }
    } else if (!isDayActive) {
      if (statusElem) {
        statusElem.className = 'inline-flex items-center gap-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 px-2.5 py-0.5 text-[11px] font-bold text-amber-600 dark:text-amber-400';
        statusElem.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span><span>Day Off (${currentDayStr} Paused)</span>`;
      }
      if (countdownElem) {
        countdownElem.textContent = 'Next Active Day: Tomorrow';
      }
    } else if (isInWindow) {
      if (statusElem) {
        statusElem.className = 'inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-0.5 text-[11px] font-bold text-emerald-600 dark:text-emerald-400';
        statusElem.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span><span>Window Active</span>`;
      }
      const intervalMins = acc.posting_interval_minutes || 30;
      if (countdownElem) {
        countdownElem.textContent = `Next Pin: ~${intervalMins} mins`;
      }
    } else {
      if (statusElem) {
        statusElem.className = 'inline-flex items-center gap-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 px-2.5 py-0.5 text-[11px] font-bold text-blue-500';
        statusElem.innerHTML = `<span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span><span>Window Closed (Overnight)</span>`;
      }
      if (countdownElem) {
        countdownElem.textContent = `Resumes at ${startStr}`;
      }
    }

    const maxDaily = acc.max_pins_per_day || 20;
    const optimalPaceMins = Math.max(1, Math.round(windowDurationMins / maxDaily));
    const configuredInterval = acc.posting_interval_minutes || 30;
    const isTooFast = configuredInterval < optimalPaceMins && maxDaily < 100;

    if (startedElem) {
      startedElem.textContent = acc.pinning_started_at ? formatDate(acc.pinning_started_at) : 'Not configured';
    }
    if (intervalElem) {
      intervalElem.textContent = configuredInterval >= 60 ? `Every ${configuredInterval / 60} ${configuredInterval === 60 ? 'hour' : 'hours'}` : `Every ${configuredInterval} mins`;
    }
    if (delayElem) {
      delayElem.textContent = `${acc.random_delay_minutes || 0} mins`;
    }
    if (lastPubElem) {
      lastPubElem.textContent = acc.last_published_at ? formatDate(acc.last_published_at) : 'No published pins yet';
    }

    if (paceValElem) {
      paceValElem.textContent = `1 pin / ${optimalPaceMins}m optimal pacing`;
    }
    if (paceDescElem) {
      paceDescElem.innerHTML = `
        <span class="block">At limit of ${maxDaily} pins/day across ${windowHours}h window, optimal interval is ~1 pin every ${optimalPaceMins} mins (Configured: ${configuredInterval}m).</span>
        ${isTooFast ? `
          <div class="mt-2.5 pt-2 border-t border-primary/20 flex flex-wrap items-center justify-between gap-2">
            <span class="text-[11px] text-amber-600 dark:text-amber-400 font-semibold flex items-center gap-1">
              ⚠️ Rapid Interval Notice: All ${maxDaily} daily pins will post in ~${configuredInterval * maxDaily} mins.
            </span>
            <button id="btn-apply-optimal-pacing" data-optimal="${optimalPaceMins}" class="inline-flex items-center gap-1 rounded-lg bg-primary px-2.5 py-1 text-xs font-bold text-primary-foreground shadow hover:bg-primary/90 transition-all">
              ⚡ Auto-Set to ${optimalPaceMins} mins
            </button>
          </div>
        ` : ''}
      `;

      if (isTooFast) {
        document.getElementById('btn-apply-optimal-pacing')?.addEventListener('click', async (e) => {
          e.preventDefault();
          const targetMins = optimalPaceMins;
          const res = await updateAccountSchedule(acc.id, { posting_interval_minutes: targetMins });
          const updated = {
            ...acc,
            ...(res.data || {}),
            posting_interval_minutes: targetMins,
          };
          refreshAccountUI(updated);
          showFeedbackBanner(`Posting interval auto-adjusted to optimal ${targetMins} minutes pacing.`, 'success');
          loadAllData();
        });
      }
    }
  }

