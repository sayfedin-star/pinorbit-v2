---
export interface Props {
  id?: string;
}
const { id = 'repurpose-modal' } = Astro.props;
---

<div
  id={id}
  class="fixed inset-0 z-50 hidden items-center justify-center bg-background/80 backdrop-blur-sm p-4 sm:p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
>
  <div class="relative w-full max-w-2xl rounded-2xl border border-border bg-card p-6 shadow-xl transition-all my-8">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-border pb-4 mb-5">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
          <span class="text-xl">📦</span>
        </div>
        <div>
          <h3 class="text-base font-bold text-foreground">Stage Pins to Dispatch Queue</h3>
          <p class="text-xs text-muted-foreground">Add winning archived pins to the queue to review, customize destination links, and assign accounts.</p>
        </div>
      </div>
      <button
        type="button"
        id="close-repurpose-btn"
        class="rounded-lg p-1.5 text-muted-foreground hover:bg-muted hover:text-foreground transition-colors cursor-pointer"
        aria-label="Close"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Selected Count Banner -->
    <div class="mb-5 flex items-center justify-between p-3.5 rounded-xl border border-border bg-muted/30 text-xs">
      <div class="flex items-center gap-2">
        <span class="font-medium text-muted-foreground">Pins to Stage:</span>
        <span id="repurpose-pin-count-badge" class="font-bold text-primary px-2.5 py-0.5 rounded-full bg-primary/10 border border-primary/20">
          0 pins selected
        </span>
      </div>
      <a href="/pinarchive/dispatched?tab=queue" class="text-xs text-primary hover:underline font-semibold flex items-center gap-1">
        <span>View Current Queue</span>
        <span>→</span>
      </a>
    </div>

    <!-- Section: Staging Defaults (Optional) -->
    <div class="mb-5 space-y-4">
      <div class="border-b border-border/60 pb-2">
        <h4 class="text-xs font-bold text-foreground flex items-center justify-between">
          <span>Staging Defaults (Optional)</span>
          <span class="text-[11px] font-normal text-muted-foreground">You can also edit each pin later in the queue</span>
        </h4>
      </div>

      <!-- Default Board Name -->
      <div>
        <label class="block text-xs font-medium text-foreground mb-1.5">
          Default Board Name (optional)
        </label>
        <input
          type="text"
          id="default-board-input"
          placeholder="Keep original board or enter default (e.g. Modern Kitchens)"
          class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
        />
      </div>

      <!-- Destination Link Options -->
      <div class="border-t border-border/40 pt-3">
        <div class="flex items-center justify-between mb-2">
          <label class="text-xs font-medium text-foreground">
            Default Destination Link
          </label>
          <a href="/pinarchive/links" target="_blank" rel="noopener noreferrer" class="text-[11px] text-primary hover:underline font-semibold cursor-pointer">
            Manage Link Notebook ↗
          </a>
        </div>

        <div class="space-y-2.5 text-xs">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="link-choice" value="original" checked class="text-primary focus:ring-primary" />
            <span class="font-medium text-foreground">Keep original pin link from archive</span>
          </label>

          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="link-choice" value="notebook" class="text-primary focus:ring-primary" />
            <span class="font-medium text-foreground">Choose from Link Notebook (★ default preselected if set)</span>
          </label>

          <div id="notebook-link-selector-container" class="hidden pl-6 space-y-2.5">
            <!-- Selected Link Chip (compact summary) -->
            <div id="notebook-selected-chip" class="hidden items-center justify-between gap-2 p-2.5 rounded-xl border border-primary/30 bg-primary/5 text-xs">
              <div class="flex items-center gap-2 min-w-0">
                <span id="chip-star" class="text-amber-500 font-bold text-sm shrink-0">⭐</span>
                <div class="min-w-0">
                  <div id="chip-label" class="font-semibold text-foreground truncate">Selected Title</div>
                  <div id="chip-url" class="font-mono text-[10px] text-muted-foreground truncate">https://...</div>
                </div>
              </div>
              <div class="flex items-center gap-1.5 shrink-0">
                <button type="button" id="chip-change-btn" class="text-[11px] text-primary hover:underline font-semibold cursor-pointer">Change</button>
                <button type="button" id="chip-clear-btn" class="text-muted-foreground hover:text-rose-500 p-1 cursor-pointer" title="Clear selection">✕</button>
              </div>
            </div>

            <!-- Combobox Picker Card -->
            <div id="notebook-combobox-picker" class="space-y-2 rounded-xl border border-border bg-card p-3 shadow-xs">
              <!-- Filter inputs bar -->
              <div class="flex flex-wrap items-center gap-2">
                <div class="relative flex-1 min-w-[130px]">
                  <input
                    type="text"
                    id="notebook-search-input"
                    placeholder="Search label, url, or slug…"
                    class="w-full rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-primary pl-7"
                  />
                  <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-2 top-2 h-3.5 w-3.5 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </div>

                <select
                  id="notebook-domain-filter"
                  class="rounded-lg border border-border bg-background px-2 py-1.5 text-xs text-foreground focus:outline-none focus:ring-1 focus:ring-primary cursor-pointer max-w-[130px]"
                >
                  <option value="">All Domains</option>
                </select>

                <select
                  id="notebook-shelf-filter"
                  class="rounded-lg border border-border bg-background px-2 py-1.5 text-xs text-foreground focus:outline-none focus:ring-1 focus:ring-primary cursor-pointer"
                >
                  <option value="all">All Shelves</option>
                  <option value="user">🌐 Global</option>
                  <option value="workspace">🏢 Workspace</option>
                </select>
              </div>

              <!-- Results info -->
              <div class="flex items-center justify-between text-[11px] text-muted-foreground px-1">
                <span id="combobox-results-count">0 links available</span>
                <span id="combobox-cap-notice" class="hidden text-amber-500 font-medium text-[10px]">Showing first 50 — narrow search</span>
              </div>

              <!-- Results scrollable list -->
              <div id="notebook-combobox-results" class="max-h-48 overflow-y-auto space-y-1 divide-y divide-border/40 pr-1">
                <!-- Rendered items (max 50) -->
              </div>
            </div>

            <!-- Hidden input for selected link URL -->
            <input type="hidden" id="chosen-notebook-url" value="" />
          </div>

          <label class="flex items-center gap-2 cursor-pointer">
            <input type="radio" name="link-choice" value="custom" class="text-primary focus:ring-primary" />
            <span class="font-medium text-foreground">Custom destination URL</span>
          </label>

          <div id="custom-link-container" class="hidden pl-6">
            <input
              type="url"
              id="custom-link-input"
              placeholder="https://mysite.com/landing-page"
              class="w-full rounded-xl border border-border bg-background px-3 py-2 text-xs text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Status Banner -->
    <div id="repurpose-status-banner" class="hidden mb-4 p-3 rounded-xl text-xs font-medium"></div>

    <!-- Footer Controls -->
    <div class="flex items-center justify-end gap-2 border-t border-border pt-4">
      <button
        type="button"
        id="cancel-repurpose-btn"
        class="rounded-xl border border-border bg-background px-4 py-2 text-xs font-semibold text-foreground hover:bg-muted transition-colors cursor-pointer"
      >
        Cancel
      </button>
      <button
        type="button"
        id="confirm-repurpose-btn"
        class="inline-flex items-center gap-1.5 rounded-xl bg-primary px-4 py-2 text-xs font-bold text-primary-foreground hover:opacity-90 transition-opacity cursor-pointer disabled:opacity-50"
      >
        <span id="repurpose-submit-text">📦 Stage Pins to Queue</span>
      </button>
    </div>
  </div>
</div>

<script>
  let selectedPins: string[] = [];
  let notebookLinks: any[] = [];

  const modal = document.getElementById('repurpose-modal');
  const closeBtn = document.getElementById('close-repurpose-btn');
  const cancelBtn = document.getElementById('cancel-repurpose-btn');
  const confirmBtn = document.getElementById('confirm-repurpose-btn') as HTMLButtonElement;
  const submitText = document.getElementById('repurpose-submit-text');
  const pinCountBadge = document.getElementById('repurpose-pin-count-badge');
  const defaultBoardInput = document.getElementById('default-board-input') as HTMLInputElement | null;
  const notebookSelectContainer = document.getElementById('notebook-link-selector-container');
  const selectedChip = document.getElementById('notebook-selected-chip');
  const chipStar = document.getElementById('chip-star');
  const chipLabel = document.getElementById('chip-label');
  const chipUrl = document.getElementById('chip-url');
  const chipChangeBtn = document.getElementById('chip-change-btn');
  const chipClearBtn = document.getElementById('chip-clear-btn');

  const comboboxPicker = document.getElementById('notebook-combobox-picker');
  const searchInput = document.getElementById('notebook-search-input') as HTMLInputElement | null;
  const domainFilter = document.getElementById('notebook-domain-filter') as HTMLSelectElement | null;
  const shelfFilter = document.getElementById('notebook-shelf-filter') as HTMLSelectElement | null;
  const resultsCountEl = document.getElementById('combobox-results-count');
  const capNoticeEl = document.getElementById('combobox-cap-notice');
  const resultsListEl = document.getElementById('notebook-combobox-results');
  const chosenUrlInput = document.getElementById('chosen-notebook-url') as HTMLInputElement | null;
  const customLinkContainer = document.getElementById('custom-link-container');
  const customLinkInput = document.getElementById('custom-link-input') as HTMLInputElement | null;
  const statusBanner = document.getElementById('repurpose-status-banner');

  let selectedLinkObj: any = null;

  function escapeHtml(str: string): string {
    return (str || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function selectLink(link: any) {
    selectedLinkObj = link;
    if (chosenUrlInput) chosenUrlInput.value = link ? link.url : '';

    if (link) {
      if (chipStar) chipStar.textContent = link.is_default ? '⭐' : '🔗';
      if (chipLabel) chipLabel.textContent = link.label || 'Link';
      if (chipUrl) chipUrl.textContent = `${link.url} (${link.domain || 'web'})`;

      if (selectedChip) {
        selectedChip.classList.remove('hidden');
        selectedChip.classList.add('flex');
      }
      if (comboboxPicker) comboboxPicker.classList.add('hidden');
    } else {
      if (selectedChip) {
        selectedChip.classList.add('hidden');
        selectedChip.classList.remove('flex');
      }
      if (comboboxPicker) comboboxPicker.classList.remove('hidden');
    }
  }

  chipChangeBtn?.addEventListener('click', () => {
    if (comboboxPicker) comboboxPicker.classList.remove('hidden');
    searchInput?.focus();
  });

  chipClearBtn?.addEventListener('click', () => {
    selectLink(null);
    renderComboboxResults();
  });

  function renderComboboxResults() {
    if (!resultsListEl) return;

    const q = (searchInput?.value || '').trim().toLowerCase().replace(/\.html$/i, '');
    const dom = (domainFilter?.value || '').trim().toLowerCase();
    const shelf = (shelfFilter?.value || 'all').toLowerCase();

    let filtered = notebookLinks.filter((item) => {
      if (shelf !== 'all' && item.scope !== shelf) return false;
      if (dom && (item.domain || '').toLowerCase() !== dom) return false;

      if (q) {
        const normLabel = (item.label || '').toLowerCase().replace(/\.html$/i, '');
        const normUrl = (item.url || '').toLowerCase().replace(/\.html$/i, '');
        const normSlug = (item.slug || '').toLowerCase().replace(/\.html$/i, '');
        if (!normLabel.includes(q) && !normUrl.includes(q) && !normSlug.includes(q)) {
          return false;
        }
      }
      return true;
    });

    filtered.sort((a, b) => {
      if (a.is_default && !b.is_default) return -1;
      if (!a.is_default && b.is_default) return 1;
      return (a.label || '').localeCompare(b.label || '');
    });

    const totalMatches = filtered.length;
    const capped = filtered.slice(0, 50);

    if (resultsCountEl) {
      resultsCountEl.textContent = `${capped.length} of ${totalMatches} links`;
    }
    if (capNoticeEl) {
      if (totalMatches > 50) capNoticeEl.classList.remove('hidden');
      else capNoticeEl.classList.add('hidden');
    }

    if (capped.length === 0) {
      resultsListEl.innerHTML = '<div class="p-3 text-center text-xs text-muted-foreground">No matching links found.</div>';
      return;
    }

    resultsListEl.innerHTML = capped.map((item) => {
      const isSelected = selectedLinkObj && selectedLinkObj.url === item.url;
      return `
        <div
          class="p-2 rounded-lg hover:bg-muted/50 transition-colors cursor-pointer flex items-center justify-between gap-2 ${isSelected ? 'bg-primary/10' : ''}"
          data-url="${escapeHtml(item.url)}"
        >
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-1.5">
              ${item.is_default ? '<span class="text-amber-500 font-bold text-xs shrink-0">⭐</span>' : ''}
              <span class="font-semibold text-foreground truncate text-xs">${escapeHtml(item.label)}</span>
              <span class="text-[10px] px-1.5 py-0.2 rounded font-mono bg-muted text-muted-foreground shrink-0">${escapeHtml(item.domain || 'web')}</span>
            </div>
            <div class="font-mono text-[10px] text-muted-foreground truncate">${escapeHtml(item.url)}</div>
          </div>
          <button type="button" class="text-[11px] font-semibold text-primary shrink-0 hover:underline">Select</button>
        </div>
      `;
    }).join('');

    resultsListEl.querySelectorAll('[data-url]').forEach((el) => {
      el.addEventListener('click', () => {
        const u = el.getAttribute('data-url');
        const match = notebookLinks.find((l) => l.url === u);
        if (match) selectLink(match);
      });
    });
  }

  searchInput?.addEventListener('input', renderComboboxResults);
  domainFilter?.addEventListener('change', renderComboboxResults);
  shelfFilter?.addEventListener('change', renderComboboxResults);

  function showStatus(htmlContent: string, type: 'error' | 'warning' | 'success') {
    if (!statusBanner) return;
    statusBanner.innerHTML = htmlContent;
    const styles = {
      error: 'mb-4 p-3 rounded-xl text-xs font-medium bg-rose-500/10 text-rose-600 border border-rose-500/20',
      warning: 'mb-4 p-3 rounded-xl text-xs font-medium bg-amber-500/10 text-amber-600 border border-amber-500/20',
      success: 'mb-4 p-3 rounded-xl text-xs font-medium bg-emerald-500/10 text-emerald-600 border border-emerald-500/20',
    };
    statusBanner.className = styles[type];
    statusBanner.classList.remove('hidden');
  }

  async function loadLinks() {
    try {
      const linksRes = await fetch('/api/links');
      const linksData = await linksRes.json();

      if (linksData.success) {
        const uLinks = (linksData.user_links || []).map((l: any) => ({ ...l, scope: 'user' }));
        const wLinks = (linksData.workspace_links || []).map((l: any) => ({ ...l, scope: 'workspace' }));
        notebookLinks = [...uLinks, ...wLinks];
        populateNotebookSelect();
      }
    } catch {
      // ignore
    }
  }

  function populateNotebookSelect() {
    if (domainFilter) {
      domainFilter.innerHTML = '<option value="">All Domains</option>';
      const domSet = new Set<string>();
      for (const l of notebookLinks) {
        if (l.domain) domSet.add(l.domain);
      }
      Array.from(domSet).sort().forEach((d) => {
        const opt = document.createElement('option');
        opt.value = d;
        opt.textContent = d;
        domainFilter.appendChild(opt);
      });
    }

    const defaultLink = notebookLinks.find((l) => l.is_default);
    if (defaultLink) {
      selectLink(defaultLink);
    } else {
      selectLink(null);
    }

    renderComboboxResults();
  }

  // Radio button link selector
  document.querySelectorAll<HTMLInputElement>('input[name="link-choice"]').forEach((radio) => {
    radio.addEventListener('change', () => {
      if (radio.value === 'notebook') {
        notebookSelectContainer?.classList.remove('hidden');
        customLinkContainer?.classList.add('hidden');
      } else if (radio.value === 'custom') {
        customLinkContainer?.classList.remove('hidden');
        notebookSelectContainer?.classList.add('hidden');
      } else {
        notebookSelectContainer?.classList.add('hidden');
        customLinkContainer?.classList.add('hidden');
      }
    });
  });

  // Confirm Stage Submit
  confirmBtn?.addEventListener('click', async () => {
    if (selectedPins.length === 0) {
      showStatus('No pins selected to stage.', 'warning');
      return;
    }

    const linkChoice = (document.querySelector<HTMLInputElement>('input[name="link-choice"]:checked'))?.value;
    let finalOverrideLink = '';

    if (linkChoice === 'notebook') {
      finalOverrideLink = chosenUrlInput?.value || selectedLinkObj?.url || '';
      if (!finalOverrideLink) {
        showStatus('Please select a destination link from the notebook.', 'warning');
        return;
      }
    } else if (linkChoice === 'custom') {
      finalOverrideLink = customLinkInput?.value?.trim() || '';
      if (!finalOverrideLink) {
        showStatus('Please enter a valid custom URL.', 'warning');
        return;
      }
    }

    const defaultBoard = defaultBoardInput?.value?.trim() || '';

    confirmBtn.disabled = true;
    if (submitText) submitText.textContent = 'Staging pins...';
    statusBanner?.classList.add('hidden');

    try {
      const res = await fetch('/api/pinarchive/staged', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          pinIds: selectedPins,
          defaults: {
            overrideLink: finalOverrideLink || undefined,
            boardName: defaultBoard || undefined,
          },
        }),
      });

      const data = await res.json();

      if (data.success) {
        showStatus(
          `✅ Success! Staged ${data.count} pin${data.count === 1 ? '' : 's'} to queue. <a href="/pinarchive/dispatched?tab=queue" class="underline font-bold ml-1.5 hover:opacity-80">Open Dispatch Queue →</a>`,
          'success'
        );

        window.dispatchEvent(new CustomEvent('repurpose-staged', { detail: data }));
        window.dispatchEvent(new CustomEvent('repurpose-completed', { detail: data }));

        setTimeout(() => {
          modal?.classList.add('hidden');
          modal?.classList.remove('flex');
        }, 2200);
      } else {
        showStatus(data.error || 'Failed to stage pins.', 'error');
        confirmBtn.disabled = false;
        if (submitText) submitText.textContent = '📦 Stage Pins to Queue';
      }
    } catch (e: any) {
      showStatus(e.message || 'Network error.', 'error');
      confirmBtn.disabled = false;
      if (submitText) submitText.textContent = '📦 Stage Pins to Queue';
    }
  });

  // Close modal
  const closeModal = () => {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    statusBanner?.classList.add('hidden');
  };
  closeBtn?.addEventListener('click', closeModal);
  cancelBtn?.addEventListener('click', closeModal);

  // Custom Event listener to open modal
  window.addEventListener('open-repurpose-modal', ((e: CustomEvent) => {
    selectedPins = e.detail?.pinIds || [];
    if (pinCountBadge) {
      pinCountBadge.textContent = `${selectedPins.length} pin${selectedPins.length === 1 ? '' : 's'} selected`;
    }
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    statusBanner?.classList.add('hidden');
    confirmBtn.disabled = selectedPins.length === 0;
    if (submitText) submitText.textContent = `📦 Stage ${selectedPins.length} Pins to Queue`;
    loadLinks();
  }) as EventListener);
</script>
